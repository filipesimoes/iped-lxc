# ==============================================================================
# IPED LXC Wrapper - Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials/configurations.
# Do not commit the actual '.env' file to your repository.

# ------------------------------------------------------------------------------
# Security Configuration
# ------------------------------------------------------------------------------
# A fixed API Key required to authenticate against all endpoints.
# Clients should send this key in the 'X-API-Key' header.
API_KEY=your-api-key-here

# Comma-separated list of allowed origins for CORS.
ALLOWED_ORIGINS=http://localhost,http://localhost:8001,http://localhost:3000

# ------------------------------------------------------------------------------
# General Configuration
# ------------------------------------------------------------------------------
# Set to True to enable mock container/Proxmox execution (useful for local development).
MOCK_MODE=True

# Base URL for the wrapper API itself.
API_BASE_URL=http://localhost:8001

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------
# Hostname/IP address of the Redis server. (Use 'redis' if running in docker-compose).
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
# Password to authenticate against Redis.
REDIS_PASSWORD=change-me-to-a-secure-password

# Session Time-To-Live in seconds (e.g. 7200 for 2 hours).
# LXC containers will be automatically stopped after this duration of inactivity.
SESSION_TTL=7200

# ------------------------------------------------------------------------------
# Proxmox VE Configuration
# ------------------------------------------------------------------------------
# Proxmox API cluster node address/hostname.
PROXMOX_HOST=192.168.1.100

# Proxmox API port (default is 8006).
PROXMOX_PORT=8006

# Username (usually root@pam).
PROXMOX_USER=root@pam

# Authentication via password (alternative to Token).
# PROXMOX_PASSWORD=your-proxmox-password

# Authentication via API Token (recommended).
PROXMOX_TOKEN_NAME=your-token-name
PROXMOX_TOKEN_VALUE=your-token-uuid-value

# Verify Proxmox VE SSL Certificate. Set to False for self-signed certificates in dev.
PROXMOX_VERIFY_SSL=True

# The port where IPED API (or Nginx Proxy) is exposed on the LXC container.
# If using Nginx with API Key authentication inside the container, set this to 80.
IPED_API_PORT=80



